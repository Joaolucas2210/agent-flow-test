# Generated activation artifacts — recreated by ./setup-adf.sh, never committed.
/.claude/agents
/.claude/commands
/.claude/skills
/.codex/agents
# .codex/skills & prompts mix committed codex-native files with ADF symlinks from
# setup-adf.sh. Ignoring the dirs hides the generated links; already-tracked files stay
# tracked (gitignore never untracks). A new codex-native file here needs `git add -f`.
/.codex/skills/
/.codex/prompts/
# /.cursor/rules holds graphify.mdc, written by `graphify install --platform cursor`.
/.cursor/commands
/.cursor/rules

# Graphify knowledge graph output (built in-agent, machine-local).
graphify-out/

# Tooling caches
/.qodo/

# Node
node_modules/

# Python bytecode (e.g. generated by the eval-agent-flow unittest gate)
__pycache__/
*.pyc

# Observability run log: machine-local (timestamps, local runs). The durable signals are
# docs/evals/results.csv and docs/metrics/history.csv; CI publishes its own summary artifact.
ai-development-framework/docs/observability/events.jsonl
ai-development-framework/docs/observability/trajectories/

# Metrics artifacts: volatile / machine-local. history.csv is the durable one, kept.
ai-development-framework/docs/metrics/rtk-report.txt
ai-development-framework/docs/metrics/graph-hits.log
